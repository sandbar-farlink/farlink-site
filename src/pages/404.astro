---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you asked for is not on the Farlink Systems site.">
  <section class="page-intro">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>That page is not here.</h1>
      <p>The link may be old or mistyped. Start from the home page or send us a note.</p>
      <p><a href="/" class="btn">Home</a> <a href="/contact" class="btn btn--ghost">Contact</a></p>
    </div>
  </section>
</Base>
